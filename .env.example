# Default mode is local, offline, and needs no secret.
RAG_DB_URI=data/news_demo.db
RAG_COLLECTION=synthetic_news_v4
RAG_GENERATOR=extractive
RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_MIN_SHARED_TERMS=2

# Optional paid provider mode. Set these only in your untracked .env or shell.
# RAG_GENERATOR=openai
# OPENAI_MODEL=<model-name>
# OPENAI_API_KEY=<api-key>

# For a remote Milvus deployment, replace RAG_DB_URI and supply a token.
# RAG_DB_URI=https://your-milvus-endpoint.example
# MILVUS_TOKEN=<username:password-or-token>
